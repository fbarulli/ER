  "cards": [
    {
      "dot": "emerald",
      "title": "Config SSOT, no fallback",
      "items": [
        "config/paths.yaml + config/training.yaml — pydantic-validated at load; a bad value crashes at import with file + field named",
        "Every knob from gate thresholds to HPO spaces lives in config; selftest oracles pin no inline literals"
      ]
    },
    {
      "dot": "violet",
      "title": "Leak-free evaluation & selection",
      "items": [
        "component_folds 50/25/25 holdout — test never trains, early-stops, or tunes",
        "HPO ranks on best_dev_ap; per-config test eval skipped (test_eval=skipped_selection_mode)",
        "Base paraphrase-multilingual-MiniLM-L12-v2; 07e rerank cross-encoder/ms-marco-MiniLM-L-6-v2, ships iff ΔPR-AUC or ΔF1 > 0.005",
        "Trackers: W&B project e-r, MLflow artifacts/mlruns"
      ]
    },
    {
      "dot": "amber",
      "title": "Nothing drops silently",
      "items": [
        "StageManifest per stage — dedupe, data_prep, labeled_pairs, evaluate_models, zero_shot_sims — under results/manifests, atomic, written last, sha256 row-accounting",
        "Colab downloads re-hash remote manifests before accepting artifacts or checkpoints",
        "dedupe.py T1/T2/T3 passes emit dataset_deduped.csv — first stage of the frozen CSV chain",
        "run_all.py steps 1-4: embeddings, sweep-2k, sweep-full, ablation — runs python -m training.train on the Colab T4; resumable via --only / --from / --stop-on-fail; appends train_manifest.csv; sweeps launched with er-colab --what hpo"
      ]
    }
