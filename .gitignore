__pycache__/
.ruff_cache/
.pytest_cache/
*.egg-info/
nohup.out
# regenerated at runtime — raw export + number reference are COMMITTED
artifacts/results/
artifacts/models/
artifacts/embeddings/
artifacts/mlruns/
artifacts/data/
.venv/
.env
.dvc-site-cache/
results/*
!results/
results/*
results/dvc_refs/
# DVC publication pointers are generated run metadata; payloads remain in
# training_results/ and the durable DVC state is owned by dvc.lock.
/dvc_refs/

# Reproducible training input: keep the raw export in Git.
!dataset.csv
# NER-side derived input; regenerated from the configured source.
dataset_model_input.csv
# Generated/model artifacts are intentionally never tracked.
*.npz
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.parquet
*.zip
# The production MiniLM bundle is shipped with the repository. Keep all
# other generated model bundles ignored.
!artifacts/models/
!artifacts/models/all-MiniLM-L6-v2/
!artifacts/models/all-MiniLM-L6-v2/**
training.log
training_results/
# Colab CLI session state and local runtime logs/cache.
colab_cli_state/
colab_system.log
matplotlib/
# Unrelated local artifact tree (contains node_modules, archives, and media).
archify/
src/ner/results/

# Generated submission outputs and local checkpoints.
submission/SKU_ITEM_submission*.csv
submission/calibration_diagnostics.csv
submission/holdout_diagnostics.csv
submission/holdout_metrics.csv
submission/plateau_diagnostic.json
submission/submission_provenance.json
submission/threshold_*.csv
submission/threshold_*.png
tmp_worker*_checkpoint/
GLM.md
wandb/

# Stray pnpm tool state in a Python repo: `package.json` holds only a
# `packageManager` pin and nothing in this project reads it. Ignored rather
# than tracked so the tree stays clean without committing tool junk.
node_modules/
pnpm-lock.yaml
package.json

# The project working agreement — a deliberately untracked LOCAL document,
# not a shipped artifact. The `.local.` filename is load-bearing: the harness
# probes AGENTS.md / CLAUDE.md / AGENTS.local.md / CLAUDE.local.md at the
# project root and points every agent (subagents included) at them, so the
# rules are auto-discovered rather than depending on a prompt mentioning them.
# Ignored so the tree stays clean while the file remains present on disk.
# Do not commit it; do not delete it.
AGENTS.local.md

# CSVs are generated or local-only by default. The versioned runtime inputs
# under data/ are the deliberate exception: they are required on a fresh
# Colab checkout for preparation, training, and inference.
*.csv
# ...EXCEPT the inputs a clone must have to run the pipeline at all. These five
# are the raw export and the frozen artifacts the lanes consume directly:
# dataset.csv is the irreplaceable source, dataset_deduped.csv is the frozen
# training input train.py reads, canonical_records/gate_results are the shared
# frozen inputs, and number_tokens_reference.csv backs build_reference.
# The DERIVED splits (sample_3000 / train_minus_3000) stay untracked on purpose:
# the sampler regenerates them deterministically from the deduped catalog at a
# fixed seed, so tracking them would only duplicate 45 MB of derived data.
!dataset.csv
!data/
!data/*.csv
