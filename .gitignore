!artifacts/models/
artifacts/models/*/
!artifacts/models/all-MiniLM-L6-v2/
!artifacts/models/all-MiniLM-L6-v2/**
!artifacts/models/tracks/
!artifacts/models/tracks/**
training.log
training_*.log
# Training-run results: ignored wholesale except what DVC retention tracks
# (the *.dvc sidecars DVC writes beside each run and its own lane .gitignore).
training_results/*
!training_results/.gitignore
!training_results/*.dvc
# Colab CLI session state and local runtime logs/cache.
colab_cli_state/
# One canonical logs root (owner order 2026-10-07): every lane/periodic log
# lives under logs/<lane>/ — kaggle/, colab/, train_footprint/. Generated
# runtime output, ignored wholesale.
logs/
# Historical root-level log names retained so stale trees stay ignored.
colab_system.log
colab_system_*.log
colab_setup_timing.log
matplotlib/
# Unrelated local artifact tree (contains node_modules, archives, and media).
archify/
src/ner/results/

# Generated submission outputs and local checkpoints.
submission/SKU_ITEM_submission*.csv
# Smoke prepare provenance metadata; the committed smoke set is the
