!artifacts/models/all-MiniLM-L6-v2/**
training.log
training_results/
# Colab CLI session state and local runtime logs/cache.
colab_cli_state/
colab_system.log
matplotlib/
# Unrelated local artifact tree (contains node_modules, archives, and media).
archify/
src/ner/results/

# Generated training splits, submission outputs, and local checkpoints.
# The smoke variants still live under artifacts/data and stay ignored; the
# real splits moved to training_data/ (rules further down).
artifacts/data/dataset_deduped_sample_*.csv
artifacts/data/dataset_deduped_train_minus_*.csv
artifacts/data/dataset_deduped_smoke_*.csv
